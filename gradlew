#!/usr/bin/env sh

# Copyright (c) 2025 Gradle authors
# This script was generated by Gradle and is meant to be committed to source control.

set -eu

APP_HOME="$(cd "$(dirname "$0")" && pwd)"
APP_NAME="Gradle"
APP_BASE_NAME="${0##*/}"
CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

# Determine the Java command to use to start the JVM.
if [ -n "${JAVA_HOME:-}" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        # IBM's JDK on AIX uses strange locations for the executables
        JAVACMD="$JAVA_HOME/jre/sh/java"
    else
        JAVACMD="$JAVA_HOME/bin/java"
    fi
    if [ ! -x "$JAVACMD" ] ; then
        echo "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME" >&2
        echo "Please set the JAVA_HOME variable in your environment to a valid Java installation." >&2
        exit 1
    fi
else
    JAVACMD="java"
    which java >/dev/null 2>&1 || {
        echo "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH." >&2
        exit 1
    }
fi

# Escape application args
for arg in "$@"; do
    case "$arg" in
        "-D"*|"-X"*|"-agentlib:"*|"-javaagent:"*|"-XX:"*|"-classpath"|"-cp")
            # Keep as-is to allow JVM options to pass through
            ;;
        *)
            # not used;
            ;;
    esac
done

if [ ! -f "$CLASSPATH" ]; then
    echo "ERROR: Missing Gradle wrapper JAR at $CLASSPATH" >&2
    echo "Please generate the wrapper with: gradle wrapper" >&2
    exit 1
fi

exec "$JAVACMD" \
    ${JAVA_OPTS:-} \
    ${GRADLE_OPTS:-} \
    -classpath "$CLASSPATH" \
    org.gradle.wrapper.GradleWrapperMain "$@"
